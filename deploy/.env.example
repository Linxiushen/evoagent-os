# every CHANGE_ME value with an independent random secret before startup.
EVOAGENT_OS_TOKEN=CHANGE_ME_control_plane_random_token
EVOAGENT_GATEWAY_TOKEN=CHANGE_ME_runtime_random_token
ECHOWEAVE_ACCESS_TOKEN=CHANGE_ME_realtime_random_token
